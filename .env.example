# =============================================================================
# Copy this file to `.env` and fill in real values for LOCAL runs.
# In GitHub Actions, set each of these as a repository Secret instead
# (Settings -> Secrets and variables -> Actions -> New repository secret).
# NEVER commit your real .env.
# =============================================================================

# ---- Shared (both agents) ----------------------------------------------------
# Notion internal integration token (starts with "ntn_" or "secret_").
# Create at https://www.notion.so/my-integrations and share BOTH databases
# (the integration must be invited to each database / its parent page).
NOTION_TOKEN=

# ntfy topic for phone push notifications. Pick a long, unguessable string,
# e.g. "marketingjobs-x7f3q9". Subscribe to it in the ntfy mobile app.
NTFY_TOPIC=

# ---- Agent 1: Job discovery (optional) --------------------------------------
# Adzuna free developer API. If unset, the Adzuna source is skipped gracefully.
# Register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI (optional) — taps Google for Jobs (LinkedIn/Indeed/
# Glassdoor). Free tier. Subscribe to "JSearch" on rapidapi.com, then copy your
# Application Key. If unset, the JSearch source is skipped.
RAPIDAPI_KEY=

# ---- Agent 2: Application-response tracker -----------------------------------
# Anthropic API key for Claude Haiku classification.
ANTHROPIC_API_KEY=

# Your Gmail address.
GMAIL_ADDRESS=

# Gmail APP PASSWORD (not your normal password). Requires 2FA enabled, then
# create one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
